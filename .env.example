# ===== RemnaShop-Pro Docker 生产环境示例 =====
# 复制为 .env 后再启动：cp .env.example .env

# 时区（建议按服务器实际时区设置）
TZ=UTC

# 安装引导阶段仅要求以下两项（会在 bootstrap.sh 中交互写入 .env）
ADMIN_ID=
BOT_TOKEN=

# 以下项目均为可选：安装不会因它们缺失而阻塞
# 可在机器人/应用内后续补充配置
PANEL_URL=
PANEL_TOKEN=
SUB_DOMAIN=
GROUP_UUID=
PANEL_VERIFY_TLS=true

# 支付宝在线支付（全空时不启用；填写时三项必须完整）
ZPAY_PID=
ZPAY_KEY=
PAYMENT_PUBLIC_URL=
# 可选渠道 ID，多个以逗号分隔
ZPAY_CID=
# HTTP 服务仅监听宿主机回环地址，由现有 HTTPS 反代转发
HTTP_PORT=8080
# 可信反代 IP/CIDR（以 HTTP 容器实际看到的代理来源为准）
# 反代必须覆盖 X-Forwarded-For；不要信任 0.0.0.0/0 或 ::/0
HTTP_TRUSTED_PROXIES=
